# Supabase — copy this file to `.env.local` and fill in the real values.
# `.env.local` is gitignored; this file is committed as documentation.
#
# Find both values in the Supabase dashboard under Project Settings → API Keys.
#
# WARNING: anything prefixed EXPO_PUBLIC_ is inlined into the compiled app in
# plain text and is readable by anyone who downloads it. Only the publishable
# (anon) key belongs here. The secret/service-role key must NEVER be given an
# EXPO_PUBLIC_ prefix or referenced from client code — it bypasses RLS.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
